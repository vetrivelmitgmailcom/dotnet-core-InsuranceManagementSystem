<script>
    $(document).ready(function () {
        $("#StateId").append('<option value="" selected disabled>..Select State..</option>');
        $("#CityId").append('<option value="" selected disabled>..Select City..</option>');
    });

    /*************************Default selected********************************************/

    function FillStates(countryList) {
        var stateList = $("#StateId");
        var cityList = $("#CityId");
        stateList.empty();
        cityList.empty();
        $("#CityId").append('<option value="" selected disabled>..Select City..</option>');

        var selectedCountry = countryList.options[countryList.selectedIndex].value;

        if (selectedCountry != null && selectedCountry != '') {
            $.getJSON("/Customer/GetStatesByCountry", { countryId: selectedCountry }, function (states) {
                if (states != null && !jQuery.isEmptyObject(states)) {
                    $.each(states, function (index, state) {
                        var option = $('<option/>', {
                            value: state.value,
                            text: state.text
                        });
                        if (state.value === "" && state.text === "..Select State..") {
                            option.prop('disabled', true);
                            option.prop('selected', true);
                        }
                        stateList.append(option);
                    });
                };
            });
        }
        return;
    }


    function FillCities(stateList) {
        var cityList = $("#CityId");
        cityList.empty();

        var selectedState = stateList.options[stateList.selectedIndex].value;

        if (selectedState != null && selectedState != '') {
            $.getJSON("/Customer/GetCitiesByState", { stateId: selectedState }, function (cities) {
                if (cities != null && !jQuery.isEmptyObject(cities)) {
                    $.each(cities, function (index, city) {
                        var option = $('<option/>', {
                            value: city.value,
                            text: city.text
                        });
                        if (city.value === "" && city.text === "..Select City..") {
                            option.prop('disabled', true);
                            option.prop('selected', true);
                        }
                        cityList.append(option);
                    });
                };
            });
        }
        return;
    }


</script>

