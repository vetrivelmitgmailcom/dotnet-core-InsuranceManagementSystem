<script>

    $(document).ready(function () {

        var checkOnClickCalculatePremiumAmountBtn = false;
        $("#calculatePremiumAmountBtn").click(function () {
            checkOnClickCalculatePremiumAmountBtn = true;
            const urlParams = new URLSearchParams(window.location.search);
            const CustomerId = urlParams.get('customerId');
            var AmountOfPeriod = $("#PolicyValue_AmountOfPeriod").val();
            var InsuredDeclaredValue = $("#PolicyValue_InsuredDeclaredValue").val();

            var flag1 = false;
            var flag2 = false;
            if (AmountOfPeriod === '') {
                flag1 = false;
                $("#PolicyValue_AmountOfPeriod").addClass('is-invalid');
                $("#AmountOfPeriod_Validation").text("Please enter No of policy period");
            }
            else {
                if (AmountOfPeriod > 100) {
                    flag1 = false;
                    $("#PolicyValue_AmountOfPeriod").addClass('is-invalid');
                    $("#AmountOfPeriod_Validation").text("The No of Policy Period should be less than 100");
                }
                else {
                    flag1 = true;
                    $("#PolicyValue_AmountOfPeriod").removeClass('is-invalid');
                }
            }

            if (InsuredDeclaredValue === '') {
                flag2 = false;
                $("#PolicyValue_InsuredDeclaredValue").addClass('is-invalid');
                $("#InsuredDeclaredValue_Validation").text("Please enter Insured Declared Value");
            }
            else {
                if (InsuredDeclaredValue > 99999999) {
                    flag2 = false;
                    $("#PolicyValue_InsuredDeclaredValue").addClass('is-invalid');
                    $("#InsuredDeclaredValue_Validation").text("Maximum Amount of IDV is 99999999");
                }
                else {
                    flag2 = true;
                    $("#PolicyValue_InsuredDeclaredValue").removeClass('is-invalid');
                }
            }


            if (flag1 == true && flag2 == true) {
                $.ajax({
                    type: "Get",
                    url: "/Policy/CalculatePremiumAmount/?customerId=" + CustomerId + "&AmountOfPeriod=" + AmountOfPeriod + "&InsuredDeclaredValue=" + InsuredDeclaredValue,
                    dataType: "json",
                    success: function (res) {
                        console.log('Calculate the Premium Amount Successful');
                        console.log(res);
                        $("#PolicyValue_PremiumToBePaid").val(res);
                        $("#PolicyValue_PremiumToBePaid_Visible").val(res);
                        $("#Amount").val(res);

                    },
                    error: function (req, status, error) {
                        console.log(req.responseText);
                        console.log(status);
                        console.log(error);
                    }
                });
            }



            if (checkOnClickCalculatePremiumAmountBtn) {
                $("#PolicyValue_AmountOfPeriod").on('input', function () {
                    var _AmountOfPeriod = $("#PolicyValue_AmountOfPeriod").val();
                    if (_AmountOfPeriod === '') {
                        $("#PolicyValue_AmountOfPeriod").addClass('is-invalid');
                        $("#AmountOfPeriod_Validation").text("Please enter No of policy period");
                    }
                    else {
                        if (_AmountOfPeriod > 100) {
                            $("#PolicyValue_AmountOfPeriod").addClass('is-invalid');
                            $("#AmountOfPeriod_Validation").text("The No of Policy Period should be less than 100");
                        }
                        else {
                            $("#PolicyValue_AmountOfPeriod").removeClass('is-invalid');
                        }
                    }
                });


                $("#PolicyValue_InsuredDeclaredValue").on('input', function () {

                    var _InsuredDeclaredValue = $("#PolicyValue_InsuredDeclaredValue").val();
                    if (_InsuredDeclaredValue === '') {
                        $("#PolicyValue_InsuredDeclaredValue").addClass('is-invalid');
                        $("#InsuredDeclaredValue_Validation").text("Please enter Insured Declared Value");
                    }
                    else {
                        if (_InsuredDeclaredValue > 99999999) {
                            $("#PolicyValue_InsuredDeclaredValue").addClass('is-invalid');
                            $("#InsuredDeclaredValue_Validation").text("Maximum Amount of IDV is 99999999");
                        }
                        else {
                            $("#PolicyValue_InsuredDeclaredValue").removeClass('is-invalid');
                        }
                    }
                });
            }
        });


        $("#clear").click(
            function () {
                $('#post-result').html("");
            });

    });
</script>



