<script>
    $(document).ready(function () {
        $("#PolicyValue_AmountOfPeriod").on('input change', function () {
            if ($(this).val().length == 1 || $(this).val().length == 2) {
                let NoOfPeriod = parseInt($(this).val()); // parse input value as an integer
                var today = new Date();                  // get current date and time
                var expirationDate = new Date(today);    // create a copy of the current date object
                expirationDate.setFullYear(today.getFullYear() + NoOfPeriod); // add NoOfPeriod years to expiration date
                var formattedDate = expirationDate.toISOString().substr(0, 10); // format the date in YYYY-MM-DD format'
                $("#DateOfExpire").val(formattedDate);
                $("#DateOfExpire_Visible").val(formattedDate);
            }
            else {
                $("#DateOfExpire").val("");
                $("#DateOfExpire_Visible").val("");
            }
        });
    });
</script>


