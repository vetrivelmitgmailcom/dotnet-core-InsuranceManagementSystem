@model InsuranceManagementSystemMVC.Models.PolicyDetail

@{
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: '@TempData["Title"]',
                html: '@TempData["SuccessMessage"]<br>@TempData["FooterMessage"]',
                confirmButtonColor: '#3B4ACC',
                confirmButtonText: 'Continue',
                allowOutsideClick: false,
                position: 'center',
                backdrop: 'rgba(0,0,0,0.9)'
            });
        </script>
    }

    ViewData["Title"] = "Adding a Policy to a customer";




    //if (!string.IsNullOrEmpty(viewTo))
    //{
    //    <text>
    //        <script>
    //            alert('@viewTo');
    //        </script>
    //    </text>
    //}

    var breadcrumb_data = "";
    if (HttpContextAccessor.HttpContext != null)
    {

        var viewFrom = HttpContextAccessor.HttpContext.Session.GetString("ViewFrom");
        switch (viewFrom)
        {
            case "RegisterCustomer":
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "RegisterCustomer");
                breadcrumb_data = "Registration";
                break;
            case "CustomerInfo":
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "CustomerInfo");
                breadcrumb_data = "Customer Details";
                break;
            case "GetCustomerInfo":
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "GetCustomerInfo");
                breadcrumb_data = "Customer Details";
                break;
            case "CustomerInfoMore":
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "CustomerInfo");
                breadcrumb_data = "Customer Details";
                break;
            case "AddPolicy":    //manual page load
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "CustomerInfo");
                breadcrumb_data = "Customer Details";
                break;
            default:
                HttpContextAccessor.HttpContext?.Session.SetString("ViewTo", "Not");
                break;
        }
    }

    var viewTo = HttpContextAccessor.HttpContext?.Session.GetString("ViewTo");
    HttpContextAccessor.HttpContext?.Session.SetString("ViewFrom", "AddPolicy");


    /***************** <a> tag Active *****************/
    ViewData["View"] = "AddPolicy";
    switch (TempData["ViewFrom"])
    {
        case "RegisterCustomer":
            ViewData["View"] = "AddPolicy";
            break;
        case "CustomerInfo":
            ViewData["View"] = "AdditionalPolicy_CustomerInfo";
            break;
        case "GetCustomerInfo":
            ViewData["View"] = "AdditionalPolicy_GetCustomerInfo";
            break;
        default:
            ViewData["View"] = "CustomerInfo";
            break;
    }
}


<div class="container-fluid">
    <div class="row bg-breadcrumb">
        <div class="col-lg-12">
            <div class="container">
                <div class="row fw-semibold fst-italic my-5">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none h5">Home</a></li>
                            <li class="breadcrumb-item"><a href="#" class="text-decoration-none h5">Customer</a></li>
                            <li class="breadcrumb-item" id="breadcrumb_item1"><a asp-controller="Customer" asp-action="@viewTo" class="text-decoration-none h5">@breadcrumb_data</a></li>
                            <li class="breadcrumb-item active" id="breadcrumb_item2" aria-current="page"><span class="h5">@breadcrumb_data</span></li>
                            <li class="breadcrumb-item active" aria-current="page"><span class="h5">Add policy</span></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <form method="post" class="needs-validation" asp-controller="Policy" asp-action="AddPolicy" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="container">
                    <div class="h1 mt-sm-5 my-lg-3 text-nav-color pt-3">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTmMQ4aKQnBi99oxSf0dk_O7rVG3H1AB_s3kA&usqp=CAU"
                             alt="family" class="img-fluid rounded-pill" style="width:50px;height:50px;">&nbsp;Adding a policy to a customer
                    </div>
                    <div class="row mt-lg-5">
                        <div class="col-lg-5 offset-lg-0">
                            <div class="card my-5 mx-2 me-2 mx-lg-0 text-center rounded-5 shadow-lg p-3 mb-5 bg-white">
                                <div class="card-header h4 bs-card-head text-white rounded-4">
                                    Calculating Premium Amount&nbsp;<i class="fa fa-users"></i>
                                </div>
                                <div class="card-body fw-bolder">
                                    <h5 class="card-title"></h5>
                                    <div class="row g-2">
                                        <div class="col-lg-6">
                                            @{
                                                var startDate = @DateTime.Now.ToString("yyyy-MM-dd");
                                                var paymentDate = @DateTime.Now.ToString("yyyy-MM-dd");
                                            }
                                            <input asp-for="CustomerId" type="hidden" value="@ViewBag.CustomerId" />
                                            <input asp-for="StatusId" type="hidden" value="1" />
                                            <label for="CustomerName" class="form-label">Customer Name</label>
                                            <input type="text" class="form-control" id="CustomerName" value="@ViewBag.CustomerName" disabled>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please enter customer Id
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <label asp-for="InsuranceId" class="form-label"></label>  @*value="Term Insurance"*@
                                            <select asp-for="InsuranceId" asp-items="ViewBag.InsuranceTypeList" class="form-select text-start" required></select>
                                            <span asp-validation-for="InsuranceId" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please select Insurance name
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <label asp-for="PolicyValue.AmountOfPeriod" class="form-label"></label>
                                            <input asp-for="PolicyValue.AmountOfPeriod" type="text" class="form-control" placeholder="Year" required />
                                            <span asp-validation-for="PolicyValue.AmountOfPeriod" class="text-danger"></span>
                                            <div id="AmountOfPeriod_Validation" class="invalid-feedback fst-italic text-end">
                                                Please enter No of policy period
                                            </div>
                                        </div>


                                        <div class="col-lg-6">
                                            <label asp-for="PolicyValue.InsuredDeclaredValue" class="form-label"></label>
                                            <input asp-for="PolicyValue.InsuredDeclaredValue" type="text" class="form-control" placeholder="(e.g. 1000000)" required />
                                            <span asp-validation-for="PolicyValue.InsuredDeclaredValue" class="text-danger"></span>
                                            <div id="InsuredDeclaredValue_Validation" class="invalid-feedback fst-italic text-end">
                                                Please enter Insured declared value
                                            </div>
                                        </div>


                                        <div class="col-lg-6">
                                            <label asp-for="DateOfIssue" class="form-label">Date of Issue&nbsp;&nbsp;<i class="fa-regular fa-calendar-days"></i></label>
                                            <input asp-for="DateOfIssue" type="hidden" value="@startDate" />
                                            <input id="DateOfIssue_Visible" type="date" class="form-control" value="@startDate" disabled />
                                            <span asp-validation-for="DateOfIssue" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                please select Date of issue
                                            </div>
                                        </div>


                                        <div class="col-lg-6">
                                            <label asp-for="DateOfExpire" class="form-label">Expiry Date&nbsp;&nbsp;<i class="fa-regular fa-calendar-days"></i></label>
                                            <input asp-for="DateOfExpire" type="hidden">
                                            <input id="DateOfExpire_Visible" type="date" class="form-control" disabled />
                                            <span asp-validation-for="DateOfExpire" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                please select Date of expire
                                            </div>
                                        </div>

                                        <div class="col-lg-12">
                                            <div class="d-grid gap-2">
                                                <button id="calculatePremiumAmountBtn" class="btn btn-primary text-white fw-semibold card-btn mt-4" type="button">
                                                    Calculate Premium Amount
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5 offset-lg-2">
                            <div class="card my-5 mx-2 me-2 mx-lg-0 text-center rounded-5 shadow-lg p-3 mb-5 bg-white rounded">
                                <div class="card-header h4 bs-card-head text-white rounded-4">
                                    Payment of the policy&nbsp;<i class="fa fa-users"></i>
                                </div>
                                <div class="card-body fw-bolder">
                                    <h5 class="card-title"></h5>

                                    <div class="row g-2">
                                        <div class="col-lg-">
                                            <label asp-for="PolicyValue.ModeOfPremiumId" class="form-label"></label>
                                            <select asp-for="PolicyValue.ModeOfPremiumId" asp-items="ViewBag.ModeOfPremiumList" class="form-select text-start" required></select>
                                            <span asp-validation-for="PolicyValue.ModeOfPremiumId" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please select mode of premium
                                            </div>
                                        </div>

                                        <div class="col-lg-12">
                                            <label asp-for="PolicyValue.PremiumToBePaid" class="form-label"></label>
                                            <input asp-for="PolicyValue.PremiumToBePaid" type="hidden">
                                            <input id="PolicyValue_PremiumToBePaid_Visible" type="text" class="form-control" placeholder="?..." disabled />
                                            <span asp-validation-for="PolicyValue.PremiumToBePaid" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please enter premium Amount
                                            </div>
                                        </div>


                                        <div class="col-lg-12">
                                            <label asp-for="PolicyValue.Payments.First().PaymentTypeId" class="form-label">Payment Type</label>
                                            <select asp-for="PolicyValue.Payments.First().PaymentTypeId" asp-items=" ViewBag.PaymentTypeList" class="form-select text-start" required></select>
                                            <span asp-validation-for="PolicyValue.Payments.First().PaymentTypeId" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please select payment type
                                            </div>
                                        </div>



                                        <div class="col-lg-12">
                                            <label asp-for="PolicyValue.Payments.First().PaymentDate" class="form-label"></label>
                                            <input asp-for="PolicyValue.Payments.First().Amount" type="hidden">
                                            <input asp-for="PolicyValue.Payments.First().PaymentDate" type="hidden" value="@paymentDate">
                                            <input type="date" value="@paymentDate" class="form-control" disabled>
                                            <span asp-validation-for="PolicyValue.Payments.First().PaymentDate" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                please select Payment Date
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-lg-0">
                        <div class="col-lg-12 offset-lg-0">
                            <div class="card my-5 mx-2 me-2 mx-lg-0 text-center rounded-5 shadow-lg p-3 mb-5 bg-white rounded">
                                <div class="card-header h4 bs-card-head text-white rounded">
                                    Nominee Details of the Policy&nbsp;<i class="fa fa-users"></i>
                                </div>
                                <div class="card-body fw-bolder">
                                    <h5 class="card-title"></h5>

                                    <div class="row g-2">
                                        <div class="col-lg-6">
                                            <label asp-for="NomineeDetails.First().NomineeName" class="form-label"></label>
                                            <input asp-for="NomineeDetails.First().NomineeName" type="text" class="form-control" placeholder="Vetrivel Murugan" required />
                                            <span asp-validation-for="NomineeDetails.First().NomineeName" class="text-danger"></span>
                                            <div id="NomineeName_Validation" class="invalid-feedback fst-italic text-end">
                                                Please enter Nominee Name
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <label asp-for="NomineeDetails.First().RelationshipId" class="form-label"></label>
                                            <select asp-for="NomineeDetails.First().RelationshipId" asp-items="ViewBag.RelationshipList" class="form-select text-start" required></select>
                                            <span asp-validation-for="NomineeDetails.First().RelationshipId" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                Please select relationship
                                            </div>
                                        </div>

                                        <div class="col-lg-6 flex-lg-wrap">
                                            <label asp-for="NomineeDetails.First().GenderId" class="form-label">Gender&nbsp;<i class="fa fa-person-half-dress" required></i> </label>
                                            <div class="form-control-plaintext fw-normal" id="gender_nominee">
                                                <div class="form-check form-check-inline">
                                                    <input asp-for="NomineeDetails.First().GenderId" class="form-check-input" type="radio" id="male" value="1" required>
                                                    <label class="form-check-label" for="male">
                                                        M
                                                    </label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input asp-for="NomineeDetails.First().GenderId" class="form-check-input" type="radio" id="female" value="2" required>
                                                    <label class="form-check-label" for="female">
                                                        F
                                                    </label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input asp-for="NomineeDetails.First().GenderId" class="form-check-input" type="radio" id="transgender" value="3" required>
                                                    <label class="form-check-label" for="transgender">
                                                        T
                                                    </label>
                                                </div>
                                                <span asp-validation-for="NomineeDetails.First().GenderId" class="text-danger"></span>
                                            </div>
                                            <div id="GenderId_Validation" class="invalid-feedback fst-italic text-center">
                                                Please select gender
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <label asp-for="NomineeDetails.First().Dob" class="form-label">Date of Birth&nbsp;&nbsp;<i class="fa-regular fa-calendar-days"></i></label>
                                            <input asp-for="NomineeDetails.First().Dob" type="date" class="form-control" required>
                                            <span asp-validation-for="NomineeDetails.First().Dob" class="text-danger"></span>
                                            <div class="invalid-feedback fst-italic text-end">
                                                please select date of birth
                                            </div>
                                        </div>


                                        <div class="col-lg-6">
                                            <label asp-for="NomineeDetails.First().MobileNumber" class="form-label"></label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text" id="mobile_symbol_nominee"><i class="fa-solid fa-phone"></i></span>
                                                <input asp-for="NomineeDetails.First().MobileNumber" type="text" class="form-control" aria-describedby="mobile" placeholder="(e.g. 6369043922)" required>
                                                <span asp-validation-for="NomineeDetails.First().MobileNumber" class="text-danger"></span>
                                                <div id="MobileNumber_Validation" class="invalid-feedback fst-italic text-end">
                                                    Please enter mobile
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-6">
                                            <label asp-for="NomineeDetails.First().PanNumber" class="form-label"></label>
                                            <input asp-for="NomineeDetails.First().PanNumber" class="form-control" placeholder="(e.g. ABCDE1234F)" required>
                                            <span asp-validation-for="NomineeDetails.First().PanNumber" class="text-danger"></span>
                                            <div id="PanNumber_Validation" class="invalid-feedback fst-italic text-end">
                                                Please enter PAN number
                                            </div>
                                        </div>


                                        <div class="col-lg-12">
                                            <label asp-for="NomineeDetails.First().AadharNumber" class="form-label"></label>
                                            <input asp-for="NomineeDetails.First().AadharNumber" type="text" class="form-control" placeholder="(format: 1234-1234-1234)" required />
                                            <span asp-validation-for="NomineeDetails.First().AadharNumber" class="text-danger"></span>
                                            <div id="AadharNumber_Validation" class="invalid-feedback fst-italic text-end">
                                                Please enter Aadhar number
                                            </div>
                                        </div>

                                        <div class="col-lg-12">
                                            <div class="d-grid gap-2">
                                                <button class="btn btn-primary text-white fw-semibold card-btn mt-4"
                                                        type="submit">
                                                    Submit
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    /********************************** Validation **********************************/
    $(document).ready(function () {
        var today = new Date();
        var day = today.getDate();
        var month = today.getMonth() + 1; // January is 0
        var year = today.getFullYear();
        if (day < 10) {
            day = '0' + day;
        }
        if (month < 10) {
            month = '0' + month;
        }
        var formattedDate_today = year + '-' + month + '-' + day;
        $('#Dob').attr('max', formattedDate_today);
    });


    $(document).ready(function () {
        // Add 'required' class to all required fields
        $('form :input[required]').addClass('required');



        // On form submit, validate required fields
        $('form').submit(function () {
            var valid = true;

            $('.required').each(function () {
                if ($(this).val() === '' || $(this).val() === null) {
                    valid = false;
                    $(this).addClass('is-invalid');
                }
                else {
                    $(this).removeClass('is-invalid');
                }
            });


            // Validate required radio buttons
            $('input[type="radio"].required').each(function () {
                var name = $(this).attr('name');
                if ($('input[name="' + name + '"]:checked').length === 0) {
                    valid = false;
                    $('input[name="' + name + '"]').addClass('is-invalid');
                }
                else {
                    $('input[name="' + name + '"]').removeClass('is-invalid');
                }
            });

            ////////////////////////////////////////////////////////////////////////////////

            // On input change, remove 'is-invalid' class if field is no longer empty
            $('form :input.required').on('input', function () {
                if ($(this).val() !== '' && $(this).val() !== null) {
                    $(this).removeClass('is-invalid');
                }
                else {
                    valid = false;
                    $(this).addClass('is-invalid');
                }
            });

            // On select change, remove 'is-invalid' class if field is no longer empty
            $('select.required').change(function () {
                if ($(this).val() !== '' && $(this).val() !== null) {
                    $(this).removeClass('is-invalid');
                }
            });

            // On radio button change, remove 'is-invalid' class from all radio buttons with the same name
            $('input[type="radio"].required').change(function () {
                var name = $(this).attr('name');
                $('input[name="' + name + '"]').removeClass('is-invalid');
            });

            /***************************************************************************************** */



            /****************************************start************************************************* */

            // Validate Amount Of Period field
            var amountOfPeriodInput = $("#PolicyValue_AmountOfPeriod");
            var amountOfPeriodValue = amountOfPeriodInput.val();
            var amountOfPeriodPattern = /^(1|[1-9][0-9]?)$/;

            if (amountOfPeriodValue === '') {
                valid = false;
                amountOfPeriodInput.addClass('is-invalid');
                $("#AmountOfPeriod_Validation").text("Please enter No of policy period");
            } else if (!amountOfPeriodPattern.test(amountOfPeriodValue)) {
                valid = false;
                amountOfPeriodInput.addClass('is-invalid');
                $("#AmountOfPeriod_Validation").text("The No of Policy Period should be less than 100");
            } else {
                amountOfPeriodInput.removeClass('is-invalid');
            }



            // Validate Amount Of Period field on change
            $("#PolicyValue_AmountOfPeriod").on("input", function () {
                var input = $(this).val();
                var pattern = /^(1|[1-9][0-9]?)$/;

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#AmountOfPeriod_Validation").text("Please enter No of policy period");
                }
                else if (!pattern.test(input)) {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#AmountOfPeriod_Validation").text("The No of Policy Period should be less than 100");
                }
                else {
                    $(this).removeClass('is-invalid');
                }
            });







            // Validate Insured Declared Value field
            var insuredDeclaredValueInput = $("#PolicyValue_InsuredDeclaredValue");
            var insuredDeclaredValueValue = insuredDeclaredValueInput.val();
            var insuredDeclaredValuePattern = /^(0|[1-9]\d{0,7})$/;

            if (insuredDeclaredValueValue === '') {
                valid = false;
                insuredDeclaredValueInput.addClass('is-invalid');
                $("#InsuredDeclaredValue_Validation").text("Please enter Insured declared value");
            } else if (!insuredDeclaredValuePattern.test(insuredDeclaredValueValue)) {
                valid = false;
                insuredDeclaredValueInput.addClass('is-invalid');
                $("#InsuredDeclaredValue_Validation").text("Maximum Amount of IDV is 99999999");
            } else {
                insuredDeclaredValueInput.removeClass('is-invalid');
            }



            // Validate Insured Declared Value field on change
            $("#PolicyValue_InsuredDeclaredValue").on("input", function () {
                var input = $(this).val();
                var pattern = /^(0|[1-9]\d{0,7})$/;

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#InsuredDeclaredValue_Validation").text("Please enter Insured declared value");
                }
                else if (!pattern.test(input)) {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#InsuredDeclaredValue_Validation").text("Maximum Amount of IDV is 99999999");
                }
                else {
                    $(this).removeClass('is-invalid');
                }
            });



            // Validate NomineeName field
            var nomineeNameInput = $("#NomineeName");
            var nomineeNameValue = nomineeNameInput.val();
            var nomineeNamePattern = /^[A-Z][a-z]*(\s[A-Z][a-z]*)$/;

            if (nomineeNameValue === '') {
                valid = false;
                nomineeNameInput.addClass('is-invalid');
                $("#NomineeName_Validation").text("Please enter Nominee name");
            } else if (!nomineeNamePattern.test(nomineeNameValue)) {
                valid = false;
                nomineeNameInput.addClass('is-invalid');
                $("#NomineeName_Validation").text("Please enter valid Nominee name(e.g. Vetrivel Murugan)");
            } else {
                nomineeNameInput.removeClass('is-invalid');
            }



            // Validate NomineeName field on change
            $("#NomineeName").on("input", function () {
                var input = $(this).val();
                var pattern = /^[A-Z][a-z]*(\s[A-Z][a-z]*)$/;

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#NomineeName_Validation").text("Please enter Nominee name");
                }
                else if (!pattern.test(input)) {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#NomineeName_Validation").text("Please enter valid Nominee name(e.g. Vetrivel Murugan)");
                }
                else {
                    $(this).removeClass('is-invalid');
                }
            });


                        // Validate Gender field
            if ($('input[name="GenderId"]:checked').length > 0) {
                   $("#GenderId_Validation").hide();
            } else {
                   $("#GenderId_Validation").show();
            }


            // Validate Gender field on change
            $('input[name="GenderId"]').change(function () {
            if ($('input[name="GenderId"]:checked').length > 0) {
                   $("#GenderId_Validation").hide();
            } else {
                   $("#GenderId_Validation").show();
            }


            });

            // Validate Mobile Number field
            var mobileNumberInput = $("#MobileNumber");
            var mobileNumberValue = mobileNumberInput.val();
            var mobileNumberPattern = /^\d{10}$/;

            if (mobileNumberValue === '') {
                valid = false;
                mobileNumberInput.addClass('is-invalid');
                $("#MobileNumber_Validation").text("Please enter Mobile Number");
            } else if (!mobileNumberPattern.test(mobileNumberValue)) {
                valid = false;
                mobileNumberInput.addClass('is-invalid');
                $("#MobileNumber_Validation").text("Please enter valid 10 digits Mobile Number");
            } else {
                $.ajax({
                    type: "Get",
                    url: "/Policy/Nominee/CheckMobileNumberExist/?mobileNumber=" + mobileNumberValue,
                    dataType: "json",
                    success: function (res) {
                        console.log('A1'+res);
                        if (res) {
                            mobile_valid_ajax = false;
                            mobileNumberInput.addClass('is-invalid');
                            $("#MobileNumber_Validation").text("Mobile number Already Exist");
                        }
                        else {
                            mobile_valid_ajax = true;
                            mobileNumberInput.removeClass('is-invalid');
                        }
                    },
                    error: function (req, status, error) {
                        console.log(req.responseText);
                        console.log(status);
                        console.log(error);
                    }
                });
            }



            // Validate Mobile Number field on change
            $("#MobileNumber").on("input", function () {
                var input = $(this).val();
                var pattern = /^\d{10}$/;

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#MobileNumber_Validation").text("Please enter Mobile Number");
                }
                else if (!pattern.test(input)) {
