<script>

    /********************************** Validation **********************************/
    $(document).ready(function () {

        // On form submit, validate required fields
        $('form').submit(function () {         //$('form').submit(function (event) {
            var valid = true;


            // Validate Email field
            var emailInput = $("#Email");
            var emailValue = emailInput.val();

            if (emailValue === '') {
                valid = false;
                emailInput.addClass('is-invalid');
                $("#Email_Validation").text("Please enter the email");
            }
            else {
                emailInput.removeClass('is-invalid');
            }




            // Validate Email field on change
            $("#Email").on("input", function () {
                var input = $(this).val();

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#Email_Validation").text("Please enter the email");
                }
                else {
                    $("#Email").removeClass('is-invalid');
                }
            });



            // Validate Password field
            var passwordInput = $("#Password");
            var passwordValue = passwordInput.val();


            if (passwordValue === '') {
                valid = false;
                passwordInput.addClass('is-invalid');
                $("#Password_Validation").text("Please enter password");
            }
            else {
                passwordInput.removeClass('is-invalid');
            }

            // Validate Password field on change
            $("#Password").on("input", function () {

                if ($(this).val() === '') {
                    valid = false;
                    $(this).addClass('is-invalid');
                    $("#Password_Validation").text("Please enter the Password");
                }
                else {
                    $(this).removeClass('is-invalid');
                }
            });

            return valid;

        });
    });
</script>

<script>
    $(document).ready(function () {
        const password = $('#Password');
        $("#showPassword").click(function () {
            if (password.prop('type') == 'password') {
                // $(this).removeClass('fa-eye');
                // $(this).addClass('fa-eye-slash');
                password.attr('type', 'text');
            } else {
                //$(this).removeClass('fa-eye-slash');
                //  $(this).addClass('fa-eye');
                password.attr('type', 'password');
            }
        });
    });
</script>