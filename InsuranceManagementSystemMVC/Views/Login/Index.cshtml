@model InsuranceManagementSystemMVC.Models.Admin

@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = " Login Page";

      
        @if (TempData["FailureMessage"] != null)
        {
            <script>
                Swal.fire({
                    icon: 'error',
                    title: '@TempData["Title"]',
                    html: '@TempData["FailureMessage"]',
                    confirmButtonColor: '#3B4ACC',
                    confirmButtonText: 'OK',
                    allowOutsideClick: true,
                    position: 'center',
                    backdrop: 'rgba(0,0,0,0.7)'
                });
            </script>

    }
}

