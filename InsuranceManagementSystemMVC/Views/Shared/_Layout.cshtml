    <script>
        //$(document).ready(function () {

        //        //$('.nav-item a').removeClass('active');
        //        $(".nav-item a").addClass('active');
        //});
    </script>



    <script>
        $(document).ready(function () {
            const views = {
                Index: { nav: '#Index' },
                About: { nav: '#About'},
                RegisterCustomer: { nav: '#RegisterCustomer', tab: '#Customer' },
                AddPolicy: { nav: '#RegisterCustomer', tab: '#Customer' },
                CustomerInfo: { nav: '#CustomerInfo', tab: '#Customer' },
                GetCustomerInfo: { nav: '#GetCustomerInfo', tab: '#Customer' },
                //////////////////////////////////////////////////////////////////
                CustomerInfoMore_CustomerInfo: { nav: '#CustomerInfo', tab: '#Customer' },
                CustomerInfoMore_GetCustomerInfo: { nav: '#GetCustomerInfo', tab: '#Customer' },
                UpdateCustomer_CustomerInfo: { nav: '#CustomerInfo', tab: '#Customer' },
                UpdateCustomer_GetCustomerInfo: { nav: '#GetCustomerInfo', tab: '#Customer' },
                AdditionalPolicy_CustomerInfo: { nav: '#CustomerInfo', tab: '#Customer' },
                AdditionalPolicy_GetCustomerInfo: { nav: '#GetCustomerInfo', tab: '#Customer' },
                //////////////////////////////////////////////////////////////////
                NomineeInfo: { nav: '#NomineeInfo', tab: '#Nominee' },
                PolicyInfo: { nav: '#PolicyInfo', tab: '#Policy' },
                GetPolicyInfo: { nav: '#GetPolicyInfo', tab: '#Policy' },
                ///////////////////////////////////////////////////////////////////
                PolicyInfoMore_PolicyInfo: { nav: '#PolicyInfo', tab: '#Policy' },
                PolicyInfoMore_GetPolicyInfo: { nav: '#GetPolicyInfo', tab: '#Policy' },
                PolicyInfoMore_CustomerInfoMore: { nav: '#CustomerInfo', tab: '#Customer' },
                ///////////////////////////////////////////////////////////////////
                AddPayments: { nav: '#AddPayments', tab: '#Payments' },
                PaymentsInfo: { nav: '#PaymentsInfo', tab: '#Payments' }
            };

            const view = "@Html.Raw(ViewData["View"] ?? "")";                                       //?? is the null-coalescing operator in C#. It is used here to provide a default value of an empty string ("") if the ViewData["View"] property is null or undefined.

            $('.nav-item a').removeClass('active');

            if (views.hasOwnProperty(view)) {
                $(views[view].nav).addClass('active');
                if (views[view].tab) {
                    $(views[view].tab).addClass('active');
                }
            } else {
                $("#Index").addClass('active');
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            var adminId = '@HttpContextAccessor.HttpContext?.Session.GetString("AdminId")';
            $('#Customer').hide();
            $('#Nominee').hide();
            $('#Policy').hide();
            $('#Payments').hide();
            $('#About').hide();
            $('#Login').show();
            $('#Logout').hide();

            if (adminId !== "") {
                // Session value exists, hide the textbox
                $('#Customer').show();
                $('#Nominee').show();
                $('#Policy').show();
                $('#Payments').show();
                $('#About').show();
                $('#Login').hide();
                $('#Logout').show();
            } else {
                // Session value does not exist, show the textbox
                $('#Customer').hide();
                $('#Nominee').hide();
                $('#Policy').hide();
                $('#Payments').hide();
                $('#About').hide();
                $('#Login').show();
                $('#Logout').hide();
            }
        });
    </script>


    <script>
        $(document).ready(function () {
            $('#Logout').click(function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Are you sure?',
                    text: "Do you want to logout?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3B4ACC',
                    confirmButtonText: 'Yes,logout!',
                    cancelButtonColor: '#d33',
                    allowOutsideClick: false,
                    position: 'top-right',
                    backdrop: 'rgba(0,0,0,0.8)'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Logout';
                    }
                });
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
