@model IEnumerable<InsuranceManagementSystemMVC.Models.Customer>


<table class="table table-hover">
    <caption>List of Customers</caption>
    <thead class="bs-nav-color table-group-divider text-white">
        @*  @Html.Raw("This is some <b>bold</b> text and <i>italic</i> text.")*@
        <tr class="text-center">
            <th scope="col">@Html.DisplayNameFor(model => model.CustomerId)</th>
            <th scope="col">Customer Name</th>
            <th scope="col">@Html.DisplayNameFor(model => model.PersonalDetails.First().Gender.Gender)</th>
            @*@foreach (var customer in Model)
            {
            @foreach (var personalDetail in customer.PersonalDetails)
            {
            @Html.DisplayNameFor(model => personalDetail.Gender)
            }
            }*@
            <th scope="col">@Html.DisplayNameFor(model => model.PersonalDetails.First().MobileNumber)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.PersonalDetails.First().Email)</th>
            <th scope="col">@Html.DisplayName("No of Policy")</th>
            <th scope="col" colspan="4">@Html.DisplayName("Content")</th>
        </tr>
    </thead>
    <tbody class="table-group-divider" id="customerList">
        @{
            foreach (var item in Model)
            {
                <tr class="text-center">
                    <td>@Html.DisplayFor(modelItem => item.CustomerId)</td>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)&nbsp;@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.PersonalDetails.First().Gender.Gender)</td>
                    <td>@Html.DisplayFor(modelItem => item.PersonalDetails.First().MobileNumber)</td>
                    <td class="no-underline">@Html.DisplayFor(modelItem => item.PersonalDetails.First().Email)</td>
                     <td>@Html.DisplayFor(modelItem => item.PolicyDetails.Count)</td>
                    <td><a class="btn btn-outline-primary me-lg-3 rounded-pill" asp-controller="Customer" asp-action="CustomerInfoMore" asp-route-customerId="@item.CustomerId">&nbsp;&nbsp;View&nbsp;&nbsp;</a></td>
                    <td><a class="btn btn-outline-success rounded-pill" asp-controller="Customer" asp-action="UpdateCustomer" asp-route-customerId="@item.CustomerId">Update</a></td>
                    <td><a class="deleteCustomer btn btn-outline-danger rounded-pill" asp-controller="Customer" asp-action="Delete" asp-route-customerId="@item.CustomerId">Delete</a></td>
                    <td><a class="btn btn-outline-success rounded-pill" asp-controller="Policy" asp-action="AddPolicy" asp-route-customerId="@item.CustomerId">Add policy</a></td>
                </tr>
            }
        }
    </tbody>
</table>



<script>
    $(document).ready(function () {
        var viewFrom = '@HttpContextAccessor.HttpContext?.Session.GetString("ViewFrom")';

        $('.deleteCustomer').click(function (e) {
            e.preventDefault();
            //HttpContextAccessor.HttpContext?.Session.SetString("ViewFrom", "CustomerInfo");    //you cannot use server-side Razor syntax directly in client-side JavaScript. Instead, you need to use an AJAX request to send the data to the server and set the session value there.
            // var customerId = $(this).attr('asp-route-customerId'); // it is not working

            var hrefValue = $(this).attr('href');
            var customerId = hrefValue.split('=')[1];     // it is working
            console.log('href:', hrefValue);
            console.log('Customer ID:', customerId);


            Swal.fire({
                title: 'Are you sure?',
                text: 'Do you want to delete this customer?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3B4ACC',
                confirmButtonText: 'Yes, Delete!',
                cancelButtonColor: '#d33',
                allowOutsideClick: false,
                position: 'center-right',
                backdrop: 'rgba(0,0,0,0.8)'
            }).then((result) => {
                if (result.isConfirmed) {
                    //window.location.href = '/Customer/Delete?customerId=' + customerId;
                    //window.location.href = hrefValue;


                    // Append the viewFrom as a query parameter to the URL
                    var redirectUrl = hrefValue + '&viewFrom=' + encodeURIComponent(viewFrom);
                    window.location.href = redirectUrl;
                }
            });
        });
    });

</script>
