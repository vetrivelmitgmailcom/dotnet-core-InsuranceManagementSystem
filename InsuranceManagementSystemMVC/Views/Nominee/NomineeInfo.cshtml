@model IEnumerable<InsuranceManagementSystemMVC.Models.NomineeDetail>

@{
    ViewData["Title"] = "Nominee Information";


    HttpContextAccessor.HttpContext?.Session.SetString("ViewFrom", "NomineeInfo");

    /***************** <a> tag Active *****************/
    ViewData["View"] = "NomineeInfo";
}



<div class="container-fluid">
    <div class="row bg-breadcrumb">
        <div class="col-lg-12">
            <div class="container">
                <div class="row fw-semibold fst-italic my-5">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none h5">Home</a></li>
                            <li class="breadcrumb-item"><a href="#" class="text-decoration-none h5">Nominee</a></li>
                            <li class="breadcrumb-item active" aria-current="page"><span class="h5">Nominee details</span></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="container">
                <div class="h1 my-lg-3 text-nav-color">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTmMQ4aKQnBi99oxSf0dk_O7rVG3H1AB_s3kA&usqp=CAU"
                         alt="family" class="img-fluid rounded-pill" style="width:50px;height:50px;">&nbsp;Nominee Details
                </div>
                <div class="row">
                    <div class="col-8 offset-4 col-lg-4 offset-lg-8">
                        <input type="text" class="form-control my-3 my-lg-2" id="searchHere"
                               placeholder="Start typing to filter...">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <caption>List of Nominee</caption>
                        <thead class="bs-nav-color table-group-divider text-white">
                            <tr class="text-center">
                                <th scope="col">#</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Policy.PolicyId)
                                </th>
                                <th>
                                    @Html.DisplayName("Customer Name")
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.NomineeName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Gender.Gender)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Dob)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.MobileNumber)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.AadharNumber)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PanNumber)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Relationship.Relationship)
                                </th>

                            </tr>
                        </thead>
                        <tbody class="table-group-divider" id="nomineeList">
                            @{
                                var count = 1;
                                foreach (var item in Model)
                                {
                                    <tr class="text-center">
                                        <th scope="row">@count</th>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Policy.PolicyId)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Policy.Customer.FirstName)&nbsp;@Html.DisplayFor(modelItem => item.Policy.Customer.LastName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NomineeName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Gender.Gender)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Dob)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.MobileNumber)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.AadharNumber)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PanNumber)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Relationship.Relationship)
                                        </td>

                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#searchHere").on("keyup", function () {
            let value = $(this).val().toLowerCase();
            $("#nomineeList tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>