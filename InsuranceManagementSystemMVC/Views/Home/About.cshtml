@{

    ViewData["Title"] = "About page";



    HttpContextAccessor.HttpContext?.Session.SetString("ViewFrom", "About");

    /***************** <a> tag Active *****************/
    ViewData["View"] = "About";
}


<div class="container-fluid sub-div2-color">
    <div class="row">
        <div class="col">
            <div class="container">
                <div class="row">
                    <div class="col-12 col-lg-6 offset-1 offset-lg-0">
                        <h1 class="py-5 mt-5 me-2 text-darkBlue">Welcome to Z<sup>X</sup> Insurance Company!</h1>
                    </div>
                    <div class="col-8 col-lg-5 offset-4 offset-lg-1">
                    </div>
                </div>
                <div class="row">
                    <div class="col-6 col-lg-3 offset-1 offset-lg-0">
                        <img src="~/images/logo2.png" class="img-fluid rounded-pill float-end mt-2" alt="logo2" style="width: 100px;height: 100px;">
                    </div>
                    <div class="col-12 col-lg-9 mt-3">
                        <p class="h3 text-pink text-center">
                            At Z<sup>X</sup> Insurance, our goal is to provide simple and hassle-free term insurance solutions that offer protection and security for you and your loved ones.
                        </p>
                        <p class="h5 text-muted text-start text-lg-start mt-3 mt-lg-4">
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <ul class="mt-4">
                            <li class="bullet">
                                <h5><b>Who We Are:</b></h5>
                                <p class="h5 text-muted">
                                    Z<sup>X</sup> Insurance is a trusted insurance provider, specializing in term insurance policies. We have a dedicated team of professionals who are passionate about helping individuals and families secure their financial future.
                                </p>
                            </li>

                            <li class="bullet">
                                <h5><b>Our Promise:</b></h5>
                                <p class="h5 text-muted">
                                    We promise to make the insurance process as simple as possible, without compromising on the quality of coverage. We understand that navigating insurance can be overwhelming, so we strive to offer straightforward solutions that are easy to understand and customize according to your needs.
                                </p>
                            </li>
                            <li class="bullet">
                                <h5><b>Why Choose Us:</b></h5>
                                <p class="h5 text-muted">
                                    <ul class="h5 text-muted">
                                        <li><b>Simplified Coverage :</b> Our term insurance policies are designed to be easy to understand and provide the essential protection you need. We cut through the jargon and complexities to offer straightforward coverage options.</li><br>
                                        <li><b>Affordability :</b> We believe that everyone should have access to affordable insurance. Our policies are priced competitively, ensuring that you can protect your loved ones without straining your budget.</li><br>
                                        <li><b>Customer Focus :</b> Your satisfaction is our top priority. Our friendly and knowledgeable customer support team is here to assist you every step of the way. We are committed to providing exceptional service and addressing your concerns promptly.</li><br>
                                        <li><b>Peace of Mind :</b> We understand that life is unpredictable, and having the right insurance coverage can bring peace of mind. Our term insurance policies offer financial security and a safety net for your family in case of unexpected events.</li><br>
                                        <li><b>Trust and Transparency :</b> We believe in building trust through transparency. We provide clear policy information, honest advice, and open communication, so you know exactly what you're getting and can make informed decisions.</li>
                                    </ul>
                                </p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*footer*@
    @*       @Html.Partial("_Footer")
    @await Html.PartialAsync("_Footer")*@
    <partial name="_Footer" />
</div>
